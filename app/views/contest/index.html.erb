<%= provide(:title, "Statistiche concorso WLM") %>

<h1 class="title"><%= ENV["TITLE"].presence || "Wiki Loves Monuments Italia" %> <%= @year&.year %></h1>
<h2 class="subtitle">Panoramica nazionale e concorsi regionali</h2>

<% if @available_years.any? %>
  <div class="tabs is-boxed mb-5">
    <ul>
      <% @available_years.each do |y| %>
        <li class="<%= 'is-active' if @year && y.id == @year.id %>">
          <%= link_to "Edizione #{y.year}", root_path(year: y.year) %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @year %>
  <section class="mb-5">
    <h2 class="title is-4 mb-3">Dati nazionali <%= @year.year %></h2>

    <div class="columns is-multiline is-variable is-2 kpi-grid">
      <div class="column is-3-desktop is-6-tablet">
        <div class="box kpi-box">
          <p class="heading">Fotografie caricate</p>
          <p class="title is-4 mb-1"><%= fmt_int(@national_photos_count) %></p>
          <div>
            <p class="is-size-7 has-text-grey">Usate su wiki (ns0): <%= fmt_int(@national_used_photos) %> (<%= fmt_pct(@national_used_pct) %>)</p>
            <%= delta_badge(@national_photos_count, @prev_national_photos_count, previous_label: @prev_year&.year) if @prev_year %>
          </div>
        </div>
      </div>

      <div class="column is-3-desktop is-6-tablet">
        <div class="box kpi-box">
          <p class="heading">Partecipanti</p>
          <p class="title is-4 mb-1"><%= fmt_int(@national_creators_count) %></p>
          <div>
            <% if @year_analytic %>
              <p class="is-size-7 has-text-grey"><%= fmt_int(@year_analytic.new_creators_count) %> nuovi / <%= fmt_int(@year_analytic.returning_creators_count) %> già registrati</p>
            <% end %>
            <%= delta_badge(@national_creators_count, @prev_national_creators_count, previous_label: @prev_year&.year) if @prev_year %>
          </div>
        </div>
      </div>

      <div class="column is-3-desktop is-6-tablet">
        <div class="box kpi-box">
          <p class="heading">Monumenti ritratti</p>
          <p class="title is-4 mb-1"><%= fmt_int(@national_depicted_monuments) %></p>
          <div>
            <p class="is-size-7 has-text-grey">
              <% if @year.year.to_i >= 2024 %>
                Nuovi monumenti: <%= fmt_int(@national_new_monuments) %>
              <% elsif @year_analytic %>
                Con un solo autore: <%= fmt_pct(@year_analytic.single_author_monuments_share) %>
              <% end %>
            </p>
            <%= delta_badge(@national_depicted_monuments, @prev_national_depicted_monuments, previous_label: @prev_year&.year) if @prev_year %>
          </div>
        </div>
      </div>

      <div class="column is-3-desktop is-6-tablet">
        <div class="box kpi-box">
          <p class="heading">Qualità e riconoscimento</p>
          <p class="title is-4 mb-1"><%= fmt_int(@national_qi_count) %> QI / <%= fmt_int(@national_fp_count) %> FP</p>
          <p class="is-size-7 has-text-grey">
            <% if @year_analytic %>
              Monumenti con 1 solo autore: <%= fmt_pct(@year_analytic.single_author_monuments_share) %>
            <% end %>
          </p>
        </div>
      </div>

      <% if @year_analytic %>
        <div class="column is-3-desktop is-6-tablet">
          <div class="box kpi-box">
            <p class="heading">Quota primi 10 uploader</p>
            <p class="title is-5 mb-1"><%= fmt_pct(@year_analytic.top10_photos_share) %></p>
            <div>
              <p class="is-size-7 has-text-grey">Foto senza primi 10: <%= fmt_int(@year_analytic.photos_without_top10) %></p>
              <%= delta_badge(@year_analytic.top10_photos_share, @prev_year_analytic&.top10_photos_share, previous_label: @prev_year&.year, invert: true) if @prev_year_analytic %>
            </div>
          </div>
        </div>

        <div class="column is-3-desktop is-6-tablet">
          <div class="box kpi-box">
            <p class="heading">Concentrazione utenti</p>
            <p class="title is-5 mb-1"><%= fmt_int(@year_analytic.creators_for_50_percent) %> per il 50% / <%= fmt_int(@year_analytic.creators_for_90_percent) %> per il 90%</p>
            <p class="is-size-7 has-text-grey">Metà inferiore: <%= fmt_pct(@year_analytic.bottom_half_photos_share) %> delle foto</p>
          </div>
        </div>

        <div class="column is-3-desktop is-6-tablet">
          <div class="box kpi-box">
            <p class="heading">Ultimi 3 giorni</p>
            <p class="title is-5 mb-1"><%= fmt_pct(@year_analytic.last_3_days_photos_share) %></p>
            <p class="is-size-7 has-text-grey"><%= fmt_int(@year_analytic.last_3_days_photos_count) %> foto dal 28 al 30 settembre</p>
          </div>
        </div>

        <div class="column is-3-desktop is-6-tablet">
          <div class="box kpi-box">
            <p class="heading">Foto per monumento</p>
            <p class="title is-5 mb-1"><%= fmt_dec(@year_analytic.avg_photos_per_monument) %> media / <%= fmt_dec(@year_analytic.median_photos_per_monument) %> mediana</p>
            <p class="is-size-7 has-text-grey">50% foto su <%= fmt_int(@year_analytic.monuments_for_50_percent_photos) %> monumenti</p>
          </div>
        </div>

        <% if @year.special? %>
          <div class="column is-6-desktop is-12-tablet">
            <div class="box kpi-box">
              <p class="heading">Tema: <%= @year.special_category_label.presence || @year.special_category %></p>
              <p class="title is-5 mb-1"><%= fmt_int(@year.special_category_total || 0) %> foto (<%= fmt_int(@year.special_depicted_monuments || 0) %> monumenti)</p>
              <p class="is-size-7 has-text-grey">
                Utenti sul tema: <%= fmt_pct(@year_analytic.special_creators_share) %> | Senza primi 10: <%= fmt_pct(@year_analytic.special_share_without_top10) %> (<%= fmt_dec(@year_analytic.special_photos_per_creator_without_top10) %> foto/utente)
              </p>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @last_nophoto %>
        <% total_m = @last_nophoto.monuments.to_i %>
        <% nophoto_m = @last_nophoto.count.to_i %>
        <div class="column is-6-desktop is-12-tablet">
          <div class="box kpi-box">
            <p class="heading">Elenco nazionale monumenti</p>
            <p class="title is-5 mb-1"><%= fmt_int(total_m - nophoto_m) %> con foto / <%= fmt_int(nophoto_m) %> senza foto (<%= fmt_pct(total_m > 0 ? nophoto_m.to_f / total_m * 100.0 : 0.0) %>)</p>
            <p class="is-size-7 has-text-grey">
              Totale elenco: <%= fmt_int(total_m) %>
              <% if @year_analytic&.bluification_count %>
                | Ritratti per la prima volta: <%= fmt_int(@year_analytic.bluification_count) %> (<%= fmt_pct(@year_analytic.bluification_rate) %>)
              <% end %>
            </p>
          </div>
        </div>
      <% end %>
    </div>

    <% if @daily_photos.any? %>
      <div class="box mt-4 chart-block">
        <h3 class="subtitle is-5 mb-3">Andamento giornaliero nazionale (<%= @year.year %>)</h3>
        <%= line_chart @daily_photos, xmin: "#{@year.year}-09-01", xmax: "#{@year.year}-09-30", colors: wlm_chart_colors, thousands: "." %>
      </div>
    <% end %>

    <% if @last_nophoto %>
      <% a = @last_nophoto.monuments.to_i %>
      <% b = @last_nophoto.count.to_i %>
      <div class="box mt-4">
        <h3 class="subtitle is-5 mb-3">Copertura monumenti senza foto (<%= @year.year %>)</h3>
        <div class="chart-block mb-5">
          <h4 class="title is-6 mb-2">Monumenti senza foto (valore assoluto)</h4>
          <%= line_chart @nophotograph, xmin: "#{@year.year}-08-31", xmax: "#{@year.year}-09-30", colors: ["#dc2626"], thousands: "." %>
        </div>
        <div class="chart-block mb-4">
          <h4 class="title is-6 mb-2">Monumenti senza foto (%)</h4>
          <%= line_chart @nophotographpercent, xmin: "#{@year.year}-08-31", xmax: "#{@year.year}-09-30", colors: ["#d97706"], suffix: "%" %>
        </div>
        <div class="columns is-multiline is-variable is-2 is-size-6 mt-2">
          <div class="column is-4"><b>Monumenti totali partecipanti</b>: <%= fmt_int(a) %></div>
          <div class="column is-4"><b>Monumenti senza foto</b>: <%= fmt_int(b) %> (<%= fmt_pct(a > 0 ? b.to_f / a * 100.0 : 0.0) %>)</div>
          <div class="column is-4"><b>Monumenti con foto</b>: <%= fmt_int(a - b) %></div>
          <div class="column is-4"><b>Senza foto prima di WLM</b>: <%= fmt_int(@first_nophoto&.count) %> (<%= fmt_pct(@first_nophoto&.percent) %>)</div>
          <div class="column is-4"><b>Con categoria su Commons</b>: <%= fmt_int(@last_nophoto.with_commons) %></div>
          <div class="column is-4"><b>Con immagine su Wikidata</b>: <%= fmt_int(@last_nophoto.with_image) %></div>
          <div class="column is-8"><b>Con immagine su Wikidata o categoria Commons ma senza foto WLM</b>: <%= fmt_int(@last_nophoto.nowlm) %></div>
          <% if @year_analytic&.bluification_count %>
            <div class="column is-4"><b>Monumenti ritratti per la prima volta</b>: <%= fmt_int(@year_analytic.bluification_count) %> (<%= fmt_pct(@year_analytic.bluification_rate) %>)</div>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>

<section class="mb-6">
  <h2 class="title is-4">Concorsi regionali (<%= @year&.year %>)</h2>
  <div class="table-container">
    <table id="elenco-concorsi" class="table is-striped is-hoverable is-fullwidth">
        <thead>
            <th>Pos.</th>
            <th>Nome del concorso</th>
            <th>Foto caricate</th>
            <th>%/t</th>
            <% if @year&.special %>
            <th><%= @year.special_category_label %></th>
            <th>%/t</th>
            <th>%</th>
            <% end %>
            <th>Foto usate (ns0)</th>
            <th>%</th>
            <th>Utenti partecipanti</th>
            <th>%/t</th>
            <th>Utenti iscritti <br />per WLM</th>
            <th>%</th>
            <th>Peso primo <br />uploader</th>
            <th>Monumenti partecipanti</th>
            <th>Monumenti senza foto</th>
            <th>%</th>
            <th>Monumenti ritratti</th>
            <th>%</th>
            <th>Nuovi monumenti</th>
            <th>%</th>
            <th>Link</th>
        </thead>
        <tbody>
            <% @contests.reverse.each do |contest| %>
            <% contestyear = @contest_years_by_contest_id[contest.id] %>
            <% next if contestyear.nil? %>
            <% cya = contestyear.contest_year_analytic %>
            <% special_pct = contestyear.count.to_i > 0 ? (contestyear.special_category_count.to_f / contestyear.count * 100.0) : 0.0 %>
            <% new_creators_pct = contestyear.creators.to_i > 0 ? (contestyear.creatorsapposta.to_f / contestyear.creators * 100.0) : 0.0 %>
            <% nophoto_pct = contestyear.monuments.to_i > 0 ? (contestyear.nophoto.to_f / contestyear.monuments * 100.0) : 0.0 %>
            <tr>
                <% pos = (@rank.find_index(contestyear.id) || 0) + 1 %>
                <th data-order="<%= pos %>"><%= pos %></th>
                <td><%= link_to contest.name, contest_path(contest, year: @year.year) %></td>
                <td data-order="<%= contestyear.count.to_i %>"><%= fmt_int(contestyear.count) %></td>
                <td data-order="<%= contestyear.percent_of_total.to_f %>"><%= fmt_dec(contestyear.percent_of_total) %></td>
            <% if @year&.special %>
                <td data-order="<%= contestyear.special_category_count.to_i %>"><%= fmt_int(contestyear.special_category_count) %></td>
                <td data-order="<%= contestyear.special_category_percent_of_total.to_f %>"><%= fmt_dec(contestyear.special_category_percent_of_total) %></td>
                <td data-order="<%= special_pct %>"><%= fmt_dec(special_pct) %></td>
            <% end %>
                <td data-order="<%= contestyear.usedonwiki.to_i %>"><%= fmt_int(contestyear.usedonwiki) %></td>
                <td data-order="<%= contestyear.usedonwiki_percentage.to_f %>"><%= fmt_dec(contestyear.usedonwiki_percentage) %></td>
                <td data-order="<%= contestyear.creators.to_i %>"><%= fmt_int(contestyear.creators) %></td>
                <td data-order="<%= contestyear.participants_percent_of_total.to_f %>"><%= fmt_dec(contestyear.participants_percent_of_total) %></td>
                <td data-order="<%= contestyear.creatorsapposta.to_i %>"><%= fmt_int(contestyear.creatorsapposta) %></td>
                <td data-order="<%= new_creators_pct %>"><%= fmt_dec(new_creators_pct) %></td>
                <td data-order="<%= cya ? cya.top1_photos_share : -1 %>"><%= cya ? fmt_pct(cya.top1_photos_share) : "-" %></td>
                <td data-order="<%= contestyear.monuments.to_i %>"><%= fmt_int(contestyear.monuments) %></td>
                <td data-order="<%= contestyear.nophoto.to_i %>"><%= fmt_int(contestyear.nophoto) %></td>
                <td data-order="<%= nophoto_pct %>"><%= fmt_dec(nophoto_pct) %></td>
                <td data-order="<%= contestyear.depicted_monuments.to_i %>"><%= fmt_int(contestyear.depicted_monuments) %></td>
                <td data-order="<%= contestyear.depicted_monuments_percentage.to_f %>"><%= fmt_dec(contestyear.depicted_monuments_percentage) %></td>
                <td data-order="<%= contestyear.new_monuments.to_i %>"><%= fmt_int(contestyear.new_monuments) %></td>
                <td data-order="<%= contestyear.new_monuments_percentage.to_f %>"><%= fmt_dec(contestyear.new_monuments_percentage) %></td>
                <td><%= link_to 'Dettaglio', contest_path(contest, year: @year.year), class: 'button is-link is-small', id: contest.id %></td>
            </tr>
            <% end %>
        </tbody>
    </table>
  </div>
</section>

<% @contests.each do |contest| %>
<% contestyear = @contest_years_by_contest_id[contest.id] %>
<% next if contestyear.nil? %>
<% if contestyear.count == 0 %>
<script>
    var btn = document.getElementById('<%= contest.id %>');
    if (btn) {
      btn.setAttribute('disabled', 'wlm-zeroelements');
      btn.addEventListener('click', function(event) {
          event.preventDefault();
      });
    }
</script>
<% end %>
<% end %>

<div class="box">
  <h2 class="subtitle is-5">Pagina personale di un utente</h2>
  <div class="field has-addons">
    <div class="control is-expanded">
      <input class="input" name="id" type="text" id="username" placeholder="Inserisci il nome utente Wikimedia">
    </div>
    <div class="control">
      <a class="button is-primary" id="username-submit">Cerca</a>
    </div>
  </div>
</div>

<div class="buttons mt-4">
  <%= link_to 'Trova i monumenti WLM vicino a te', 'https://app.wikilovesmonuments.it', class: 'button is-danger' %>
  <%= link_to "Aiuta a creare le categorie per i monumenti con un'immagine ma sprovvisti di categoria", "https://it.wikipedia.org/wiki/Progetto:Wiki_Loves_Monuments/Manutenzione/Monumenti_con_immagine_senza_categoria", class: 'button is-warning' %>
</div>

<script>
    $('#username-submit').click(function() {
        var link = '/creators/' + encodeURIComponent($('#username').val());
        $('#username-submit').attr('href', link);
    });
    $('#elenco-concorsi').DataTable({
        dom: 'Bfrtip',
        buttons: [
            'copy', 'csv', 'excel', 'pdf', 'print'
        ]
    });
</script>
