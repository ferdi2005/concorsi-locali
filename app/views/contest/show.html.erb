<%= provide(:title, @contest.name) %>
<% if @contest.region.present? %>
  <div class="buttons">
    <%= link_to "Monumenti recenti (#{@contest.region})", recent_monuments_maintenance_path(regione: @contest.region), class: "button is-small is-warning is-light" %>
  </div>
<% end %>

<% if @contest.logo.attached? %>
<div class="columns is-vcentered">
    <div class="column is-narrow">
        <%= image_tag @contest.logo.variant(resize_to_limit: [160, 160]) if @contest.logo.attached? %>
    </div>
    <div class="column">
        <h1 class="title"><%= @contest.name %></h1>
    </div>
</div>
<% else %>
<h1 class="title"><%= @contest.name %></h1>
<% end %>

<% if @contest_years_history.size > 1 %>
<section class="box mb-5">
  <h2 class="title is-4">Panoramica pluriennale del concorso</h2>
  <div class="columns">
    <div class="column">
      <h3 class="subtitle is-6">Foto caricate per edizione</h3>
      <%= column_chart @history_photos_series, colors: ["#2563eb"], thousands: "." %>
    </div>
    <div class="column">
      <h3 class="subtitle is-6">Partecipanti per edizione</h3>
      <%= line_chart @history_creators_series, colors: ["#16a34a"], thousands: "." %>
    </div>
    <div class="column">
      <h3 class="subtitle is-6">Peso del primo uploader (%)</h3>
      <%= line_chart @history_top1_share_series, colors: ["#dc2626"], suffix: "%" %>
    </div>
  </div>

  <div class="table-container">
    <table class="table is-striped is-fullwidth is-narrow">
      <thead>
        <tr>
          <th>Anno</th>
          <th>Foto</th>
          <th>Partecipanti</th>
          <th>Nuovi iscritti</th>
          <th>Peso primo uploader</th>
          <th>Primo uploader</th>
          <th>Quota primi 10</th>
        </tr>
      </thead>
      <tbody>
        <% @contest_years_history.reverse.each_with_index do |cy, idx| %>
          <% prev_cy = @contest_years_history.reverse[idx + 1] %>
          <% cya = cy.contest_year_analytic %>
          <tr class="<%= 'is-selected' if @selected_year && cy.year_id == @selected_year.id %>">
            <th><%= link_to cy.year.year, contest_path(@contest, year: cy.year.year) %></th>
            <td>
              <%= fmt_int(cy.count) %>
              <% if prev_cy && prev_cy.count.to_i > 0 %>
                <% diff = ((cy.count.to_f - prev_cy.count.to_f) / prev_cy.count.to_f * 100.0).round(1) %>
                <span class="is-size-7 <%= diff >= 0 ? 'has-text-success' : 'has-text-danger' %>">(<%= diff > 0 ? "+#{fmt_dec(diff)}" : fmt_dec(diff) %>%)</span>
              <% end %>
            </td>
            <td>
              <%= fmt_int(cy.creators) %>
              <% if prev_cy && prev_cy.creators.to_i > 0 %>
                <% diff_c = ((cy.creators.to_f - prev_cy.creators.to_f) / prev_cy.creators.to_f * 100.0).round(1) %>
                <span class="is-size-7 <%= diff_c >= 0 ? 'has-text-success' : 'has-text-danger' %>">(<%= diff_c > 0 ? "+#{fmt_dec(diff_c)}" : fmt_dec(diff_c) %>%)</span>
              <% end %>
            </td>
            <td><%= fmt_int(cya ? cya.new_creators_count : cy.creatorsapposta) %></td>
            <td><%= cya ? fmt_pct(cya.top1_photos_share) : "-" %></td>
            <td>
              <% if cya&.top1_creator %>
                <%= link_to cya.top1_creator.username, creator_path(cya.top1_creator) %>
              <% else %>
                -
              <% end %>
            </td>
            <td><%= cya ? fmt_pct(cya.top10_photos_share) : "-" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% regional_retention = @regional_trends && @regional_trends[:wlm_retention] %>
  <% if regional_retention && (regional_retention[:yoy_rows].any? || regional_retention[:editions_distribution].any?) %>
    <h3 class="subtitle is-5 mt-5">Fedeltà e ritorno nel concorso</h3>
    <div class="columns">
      <% if regional_retention[:yoy_rows].any? %>
        <div class="column">
          <div class="table-container">
            <table class="table is-striped is-fullwidth is-narrow">
              <thead>
                <tr>
                  <th>Edizione</th>
                  <th>Partecipanti</th>
                  <th>Tornati nell'edizione successiva</th>
                  <th>Ritorno nuovi iscritti</th>
                  <th>Ritorno già registrati</th>
                </tr>
              </thead>
              <tbody>
                <% regional_retention[:yoy_rows].reverse.each do |row| %>
                  <tr>
                    <th><%= row[:year] %> → <%= row[:next_year] %></th>
                    <td><%= fmt_int(row[:participants]) %></td>
                    <td><%= fmt_int(row[:returned_next]) %> (<%= fmt_pct(row[:return_rate_next]) %>)</td>
                    <td><%= fmt_int(row[:new_returned_next]) %>/<%= fmt_int(row[:new_participants]) %> (<%= fmt_pct(row[:new_return_rate_next]) %>)</td>
                    <td><%= fmt_int(row[:veteran_returned_next]) %>/<%= fmt_int(row[:veteran_participants]) %> (<%= fmt_pct(row[:veteran_return_rate_next]) %>)</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>

      <% if regional_retention[:editions_distribution].any? %>
        <div class="column">
          <div class="table-container">
            <table class="table is-striped is-fullwidth is-narrow">
              <thead>
                <tr>
                  <th>Edizioni partecipate</th>
                  <th>Partecipanti</th>
                  <th>Quota utenti</th>
                  <th>Foto</th>
                </tr>
              </thead>
              <tbody>
                <% regional_retention[:editions_distribution].each do |d| %>
                  <tr>
                    <td><%= d[:label] %></td>
                    <td><%= fmt_int(d[:creators]) %></td>
                    <td><%= fmt_pct(d[:creators_pct]) %></td>
                    <td><%= fmt_int(d[:photos]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% regional_nophoto_hist = @regional_trends && @regional_trends[:nophoto_history] %>
  <% if regional_nophoto_hist && regional_nophoto_hist[:rows].size > 1 %>
    <h3 class="subtitle is-5 mt-4">Quota monumenti senza foto tra le edizioni (%)</h3>
    <%= line_chart regional_nophoto_hist[:without_photo_pct_series], colors: ["#dc2626"], suffix: "%" %>
  <% end %>
</section>
<% end %>

<% if @available_years.any? %>
<div class="tabs is-boxed mb-4">
  <ul>
    <% @available_years.each do |y| %>
      <li class="<%= 'is-active' if @selected_year && y.id == @selected_year.id %>">
        <%= link_to "Edizione #{y.year}", contest_path(@contest, year: y.year) %>
      </li>
    <% end %>
  </ul>
</div>
<% end %>

<% if @selected_year %>
  <h2 class="title is-4 mb-3">Dettaglio edizione <%= @selected_year.year %></h2>

  <% if @contestyear || @contestyear_analytic %>
    <div class="columns is-multiline is-variable is-2 kpi-grid mb-4">
      <% if @contestyear %>
        <div class="column is-4-desktop is-6-tablet">
          <div class="box kpi-box">
            <p class="heading">Fotografie caricate</p>
            <p class="title is-4 mb-1"><%= fmt_int(@contestyear.count) %></p>
            <div>
              <p class="is-size-7 has-text-grey">Usate su wiki (ns0): <%= fmt_int(@contestyear.usedonwiki) %> (<%= fmt_pct(@contestyear.usedonwiki_percentage) %>)</p>
              <%= delta_badge(@contestyear.count, @prev_contestyear&.count, previous_label: @prev_contestyear&.year&.year) if @prev_contestyear %>
            </div>
          </div>
        </div>

        <div class="column is-4-desktop is-6-tablet">
          <div class="box kpi-box">
            <p class="heading">Partecipanti</p>
            <p class="title is-4 mb-1"><%= fmt_int(@contestyear.creators) %></p>
            <div>
              <% if @contestyear_analytic %>
                <p class="is-size-7 has-text-grey"><%= fmt_int(@contestyear_analytic.new_creators_count) %> nuovi / <%= fmt_int(@contestyear_analytic.returning_creators_count) %> già registrati</p>
              <% end %>
              <%= delta_badge(@contestyear.creators, @prev_contestyear&.creators, previous_label: @prev_contestyear&.year&.year) if @prev_contestyear %>
            </div>
          </div>
        </div>

        <div class="column is-4-desktop is-6-tablet">
          <div class="box kpi-box">
            <p class="heading">Monumenti ritratti</p>
            <p class="title is-4 mb-1"><%= fmt_int(@contestyear.depicted_monuments) %></p>
            <div>
              <p class="is-size-7 has-text-grey">Nuovi monumenti: <%= fmt_int(@contestyear.new_monuments) %></p>
              <%= delta_badge(@contestyear.depicted_monuments, @prev_contestyear&.depicted_monuments, previous_label: @prev_contestyear&.year&.year) if @prev_contestyear %>
            </div>
          </div>
        </div>
      <% end %>

      <% if @contestyear_analytic %>
        <div class="column is-4-desktop is-6-tablet">
          <div class="box kpi-box">
            <p class="heading">Peso primo uploader</p>
            <p class="title is-5 mb-1"><%= fmt_pct(@contestyear_analytic.top1_photos_share) %> (<%= fmt_int(@contestyear_analytic.top1_photos_count) %> foto)</p>
            <div>
              <%= delta_badge(@contestyear_analytic.top1_photos_share, @prev_contestyear_analytic&.top1_photos_share, previous_label: @prev_contestyear&.year&.year, invert: true) if @prev_contestyear_analytic %>
            </div>
          </div>
        </div>

        <div class="column is-4-desktop is-6-tablet">
          <div class="box kpi-box">
            <p class="heading">Foto senza primi 10</p>
            <p class="title is-5 mb-1"><%= fmt_int(@contestyear_analytic.photos_without_top10) %> (primi 10: <%= fmt_pct(@contestyear_analytic.top10_photos_share) %>)</p>
            <div>
              <%= delta_badge(@contestyear_analytic.photos_without_top10, @prev_contestyear_analytic&.photos_without_top10, previous_label: @prev_contestyear&.year&.year) if @prev_contestyear_analytic %>
            </div>
          </div>
        </div>

        <div class="column is-4-desktop is-6-tablet">
          <div class="box kpi-box">
            <p class="heading">Ultimi 3 giorni</p>
            <p class="title is-5 mb-1"><%= fmt_pct(@contestyear_analytic.last_3_days_photos_share) %></p>
            <div>
              <%= delta_badge(@contestyear_analytic.last_3_days_photos_share, @prev_contestyear_analytic&.last_3_days_photos_share, previous_label: @prev_contestyear&.year&.year, invert: true) if @prev_contestyear_analytic %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="box">
    <h3 class="subtitle is-5">Andamento giornaliero</h3>
    <%= line_chart @daily_photos, xmin: "#{@selected_year.year}-09-01", xmax: "#{@selected_year.year}-09-30", colors: wlm_chart_colors, thousands: "." %>
  </div>

  <h3 class="subtitle is-5 mt-5">Classifica degli utenti (<%= @selected_year.year %>)</h3>
  <div class="table-container">
    <table class="table is-striped is-fullwidth">
        <thead>
            <th>Nome utente</th>
            <th>Foto caricate</th>
            <th>Foto usate su wiki</th>
            <th>Foto di nuovi monumenti</th>
            <th>Data di iscrizione (iscritto per WLM)</th>
        </thead>
        <tbody>
            <% @creator_rows.each do |row| %>
            <tr>
                <td><%= link_to row[:username], creator_path(row[:id], year: @selected_year.year) %></td>
                <td><%= fmt_int(row[:photos_count]) %></td>
                <td><%= fmt_int(row[:used_count]) %> (<%= fmt_pct(row[:used_pct]) %>)</td>
                <td><%= fmt_int(row[:new_monument_count]) %> (<%= fmt_pct(row[:new_monument_pct]) %>)</td>
                <td><%= row[:creationdate]&.strftime('%d/%m/%Y') %> (<%= row[:is_new] ? 'Sì' : 'No' %>)</td>
            </tr>
            <% end %>
        </tbody>
    </table>
  </div>

  <% if @regional_top_monuments.any? %>
    <h3 class="subtitle is-5 mt-5">Monumenti più fotografati (<%= @selected_year.year %>)</h3>
    <div class="table-container">
      <table class="table is-striped is-fullwidth">
        <thead>
          <tr>
            <th>Monumento</th>
            <th>Comune</th>
            <th>Tipologia</th>
            <th>Foto</th>
            <th>Autori distinti</th>
          </tr>
        </thead>
        <tbody>
          <% @regional_top_monuments.each do |m| %>
            <tr>
              <td>
                <% if m[:item] %>
                  <%= link_to(m[:label].presence || m[:item], "https://www.wikidata.org/wiki/#{m[:item]}", target: "_blank", rel: "noopener") %>
                <% else %>
                  <%= m[:wlmid] %>
                <% end %>
                <span class="is-size-7 has-text-grey">(<%= m[:wlmid] %>)</span>
              </td>
              <td><%= m[:city].presence || "-" %></td>
              <td><%= m[:monument_type].presence || "-" %></td>
              <td><%= fmt_int(m[:photos]) %></td>
              <td><%= fmt_int(m[:authors]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @regional_edition_insights %>
    <div class="columns is-multiline mt-4">
      <% if @regional_edition_insights[:participant_buckets].any? %>
        <div class="column is-6-desktop is-12-tablet">
          <div class="box kpi-box">
            <h3 class="subtitle is-5 mb-3">Fasce di foto per partecipante (<%= @selected_year.year %>)</h3>
            <div class="table-container mb-0">
              <table class="table is-striped is-fullwidth is-narrow">
                <thead>
                  <tr>
                    <th>Fascia</th>
                    <th>Partecipanti</th>
                    <th>Quota utenti</th>
                    <th>Foto</th>
                    <th>Quota foto</th>
                  </tr>
                </thead>
                <tbody>
                  <% @regional_edition_insights[:participant_buckets].each do |b| %>
                    <tr>
                      <td><%= b[:label] %></td>
                      <td><%= fmt_int(b[:creators]) %></td>
                      <td><%= fmt_pct(b[:creators_pct]) %></td>
                      <td><%= fmt_int(b[:photos]) %></td>
                      <td><%= fmt_pct(b[:photos_pct]) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% end %>

      <% newcomers = @regional_edition_insights[:newcomers_profile] %>
      <% if newcomers && newcomers[:newcomers_count] > 0 %>
        <div class="column is-6-desktop is-12-tablet">
          <div class="box kpi-box">
            <h3 class="subtitle is-5 mb-3">Profilo dei nuovi iscritti (<%= @selected_year.year %>)</h3>
            <p class="mb-2">
              <b>Nuovi iscritti</b>: <%= fmt_int(newcomers[:newcomers_count]) %> (<%= fmt_int(newcomers[:photos_total]) %> foto)
            </p>
            <% if newcomers[:checked_photos] > 0 %>
              <p class="is-size-7 has-text-grey mb-2">
                Smartphone: <%= fmt_pct(newcomers[:smartphone_pct]) %> delle foto (<%= fmt_pct(newcomers[:smartphone_users_pct]) %> degli utenti) | Fotocamera: <%= fmt_pct(newcomers[:camera_pct]) %> | Senza EXIF: <%= fmt_pct(newcomers[:no_exif_pct]) %>
              </p>
              <% if newcomers[:by_source].any? %>
                <div class="table-container mb-0">
                  <table class="table is-striped is-fullwidth is-narrow">
                    <thead>
                      <tr>
                        <th>Canale di caricamento</th>
                        <th>Foto</th>
                        <th>Senza EXIF</th>
                        <th>Quota senza EXIF</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% newcomers[:by_source].each do |src| %>
                        <tr>
                          <td><%= src[:source] %></td>
                          <td><%= fmt_int(src[:total]) %></td>
                          <td><%= fmt_int(src[:no_exif]) %></td>
                          <td><%= fmt_pct(src[:no_exif_pct]) %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @regional_year_camera_models.any? %>
      <h3 class="subtitle is-5 mt-4">Modelli di fotocamera più usati (<%= @selected_year.year %>)</h3>
      <div class="table-container">
        <table class="table is-striped is-fullwidth is-narrow">
          <thead>
            <tr>
              <th>Marca e modello</th>
              <th>Tipo</th>
              <th>Foto</th>
              <th>Quota</th>
              <th>Utenti</th>
            </tr>
          </thead>
          <tbody>
            <% @regional_year_camera_models.each do |m| %>
              <tr>
                <td><%= [m[:make], m[:model]].compact.join(" ") %></td>
                <td><%= m[:device_category] %></td>
                <td><%= fmt_int(m[:photos]) %></td>
                <td><%= fmt_pct(m[:share]) %></td>
                <td><%= fmt_int(m[:users]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @regional_edition_insights[:top_viewed_pages].any? %>
      <h3 class="subtitle is-5 mt-4">Prime 10 voci Wikipedia per visite (<%= @selected_year.year %>)</h3>
      <div class="table-container">
        <table class="table is-striped is-fullwidth is-narrow">
          <thead>
            <tr>
              <th>Voce</th>
              <th>Progetto</th>
              <th>Visite registrate</th>
            </tr>
          </thead>
          <tbody>
            <% @regional_edition_insights[:top_viewed_pages].each do |p| %>
              <tr>
                <td><%= p[:url] ? link_to(p[:page_title], p[:url], target: "_blank", rel: "noopener") : p[:page_title] %></td>
                <td><%= p[:wiki] %></td>
                <td><%= fmt_int(p[:views]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>

  <div class="buttons is-centered my-5">
      <%= link_to 'Categoria delle foto caricate', "https://commons.wikimedia.org/wiki/#{@contest.cat_name(@selected_year)}", class: 'button is-link' %>
      <%= link_to 'Pagina ufficiale del concorso', @contest.url, class: 'button is-danger' %>
  </div>

  <% if @new_creators_daily.any? %>
    <div class="box">
      <h3 class="subtitle is-5">Utenti iscritti appositamente per WLM (<%= @selected_year.year %>)</h3>
      <%= line_chart @new_creators_daily, xmin: "#{@selected_year.year}-09-01", xmax: "#{@selected_year.year}-09-30", colors: ["#16a34a"], thousands: "." %>
    </div>
  <% end %>

  <% if @last_nophoto && @contest.region.present? %>
    <div class="box">
      <h3 class="subtitle is-5 mb-3">Monumenti senza foto (<%= @selected_year.year %>)</h3>
      <div class="chart-block mb-5">
        <h4 class="title is-6 mb-2">Valore assoluto</h4>
        <%= line_chart @nophotograph, xmin: "#{@selected_year.year}-08-31", xmax: "#{@selected_year.year}-09-30", colors: ["#dc2626"], thousands: "." %>
      </div>
      <div class="chart-block mb-4">
        <h4 class="title is-6 mb-2">Percentuale</h4>
        <%= line_chart @nophotographpercent, xmin: "#{@selected_year.year}-08-31", xmax: "#{@selected_year.year}-09-30", colors: ["#d97706"], suffix: "%" %>
      </div>
      <% total_m = @last_nophoto.monuments.to_i %>
      <% nophoto_m = @last_nophoto.count.to_i %>
      <div class="columns is-multiline mt-2">
        <div class="column is-4"><b>Monumenti totali partecipanti</b>: <%= fmt_int(total_m) %></div>
        <div class="column is-4"><b>Monumenti senza foto</b>: <%= fmt_int(nophoto_m) %> (<%= fmt_pct(total_m > 0 ? nophoto_m.to_f / total_m * 100.0 : 0.0) %>)</div>
        <div class="column is-4"><b>Monumenti con foto</b>: <%= fmt_int(total_m - nophoto_m) %></div>
        <div class="column is-4"><b>Senza foto prima di WLM</b>: <%= fmt_int(@first_nophoto&.count) %> (<%= fmt_pct(@first_nophoto&.percent) %>)</div>
        <div class="column is-4"><b>Con categoria su Commons</b>: <%= fmt_int(@last_nophoto.with_commons) %></div>
        <div class="column is-4"><b>Con immagine su Wikidata</b>: <%= fmt_int(@last_nophoto.with_image) %></div>
        <div class="column is-12"><b>Con immagine su Wikidata o categoria Commons ma senza foto WLM</b>: <%= fmt_int(@last_nophoto.nowlm) %></div>
      </div>
    </div>
  <% end %>
<% end %>

<% if @regional_monuments_coverage %>
  <% sent = @regional_monuments_coverage[:sentinels] %>
  <% small = @regional_monuments_coverage[:small_municipalities] %>
  <section class="box mt-5">
    <h2 class="title is-4">Comuni piccoli, tipologie e sentinelle (<%= @contest.region %>)</h2>
    <div class="columns is-multiline mb-4">
      <div class="column is-3">
        <div class="box kpi-box">
          <p class="heading">Senza voce Wikipedia</p>
          <p class="title is-5"><%= fmt_int(sent[:without_wikipedia]) %> (<%= fmt_pct(sent[:total] > 0 ? sent[:without_wikipedia].to_f / sent[:total] * 100 : 0) %>)</p>
        </div>
      </div>
      <div class="column is-3">
        <div class="box kpi-box">
          <p class="heading">Senza categoria Commons</p>
          <p class="title is-5"><%= fmt_int(sent[:without_commons]) %> (<%= fmt_pct(sent[:total] > 0 ? sent[:without_commons].to_f / sent[:total] * 100 : 0) %>)</p>
        </div>
      </div>
      <div class="column is-3">
        <div class="box kpi-box">
          <p class="heading">Con foto WLM senza categoria</p>
          <p class="title is-5"><%= fmt_int(sent[:with_wlm_without_commons]) %></p>
        </div>
      </div>
      <div class="column is-3">
        <div class="box kpi-box">
          <p class="heading">Con foto WLM senza P18</p>
          <p class="title is-5"><%= fmt_int(sent[:with_wlm_without_p18]) %></p>
        </div>
      </div>
      <div class="column is-4">
        <div class="box kpi-box">
          <p class="heading">Comuni sotto 5.000 abitanti</p>
          <p class="title is-5"><%= fmt_pct(small[:no_photo_share]) %> dei rossi / <%= fmt_pct(small[:photos_share]) %> delle foto</p>
          <p class="is-size-7 has-text-grey"><%= fmt_int(small[:no_photo_monuments]) %> rossi su <%= fmt_int(small[:total_monuments]) %> monumenti</p>
        </div>
      </div>
      <div class="column is-4">
        <div class="box kpi-box">
          <p class="heading">Comuni mai toccati</p>
          <p class="title is-5"><%= fmt_int(small[:untouched_municipalities]) %> / <%= fmt_int(small[:total_municipalities]) %></p>
        </div>
      </div>
      <div class="column is-4">
        <div class="box kpi-box">
          <p class="heading">Catalogo MiC e monumenti recenti</p>
          <p class="title is-5"><%= fmt_int(sent[:with_mic_catalog]) %> MiC / <%= link_to "#{fmt_int(sent[:recent_since_1950])} recenti", recent_monuments_maintenance_path(regione: @contest.region) %></p>
        </div>
      </div>
    </div>

    <div class="table-container">
      <table class="table is-striped is-fullwidth is-narrow">
        <thead>
          <tr>
            <th>Tipologia</th>
            <th>Monumenti totali</th>
            <th>Monumenti senza foto</th>
            <th>Quota senza foto (%)</th>
          </tr>
        </thead>
        <tbody>
          <% @regional_monuments_coverage[:types_stats].each do |row| %>
            <tr>
              <td><%= row[:type] %></td>
              <td><%= fmt_int(row[:total]) %></td>
              <td><%= fmt_int(row[:no_photo]) %></td>
              <td><%= fmt_pct(row[:no_photo_pct]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<% if @regional_exif && @regional_exif[:by_year].any? %>
  <section class="box mt-5">
    <h2 class="title is-4">Metadati EXIF e dispositivi nel concorso</h2>
    <div class="table-container">
      <table class="table is-striped is-fullwidth is-narrow">
        <thead>
          <tr>
            <th>Anno</th>
            <th>Foto analizzate</th>
            <th>Archivio (prima dell'anno)</th>
            <th>Smartphone (% foto / % utenti)</th>
            <th>Fotocamera (% foto / % utenti)</th>
            <th>Senza EXIF</th>
          </tr>
        </thead>
        <tbody>
          <% @contest_years_history.reverse.each do |cy| %>
            <% ex = @regional_exif[:by_year][cy.year_id] %>
            <% next if ex.nil? %>
            <tr>
              <th><%= cy.year.year %></th>
              <td><%= fmt_int(ex[:checked]) %></td>
              <td><%= fmt_pct(ex[:archive_pct]) %></td>
              <td><%= fmt_pct(ex[:smartphone_pct]) %> / <%= fmt_pct(ex[:smartphone_users_pct]) %></td>
              <td><%= fmt_pct(ex[:camera_pct]) %> / <%= fmt_pct(ex[:camera_users_pct]) %></td>
              <td><%= fmt_pct(ex[:no_exif_pct]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @regional_exif[:top_models].any? %>
      <h3 class="subtitle is-6 mt-4">Modelli più usati (tutte le edizioni)</h3>
      <div class="table-container">
        <table class="table is-striped is-fullwidth is-narrow">
          <thead>
            <tr>
              <th>Marca e modello</th>
              <th>Categoria</th>
              <th>Foto</th>
              <th>Quota (%)</th>
              <th>Utenti</th>
            </tr>
          </thead>
          <tbody>
            <% @regional_exif[:top_models].each do |m| %>
              <tr>
                <td><%= [m[:make], m[:model]].compact.join(" ") %></td>
                <td><%= m[:device_category] %></td>
                <td><%= fmt_int(m[:photos]) %></td>
                <td><%= fmt_pct(m[:share]) %></td>
                <td><%= fmt_int(m[:users]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
<% end %>

<% if @regional_pageviews && @regional_pageviews[:by_year].any? %>
  <section class="box mt-5">
    <h2 class="title is-4">Impatto su Wikipedia e visite alle voci</h2>
    <div class="table-container">
      <table class="table is-striped is-fullwidth is-narrow">
        <thead>
          <tr>
            <th>Anno</th>
            <th>Voci distinte</th>
            <th>Progetti / lingue</th>
            <th>Visite registrate</th>
            <th>Quota prime 12 voci (%)</th>
          </tr>
        </thead>
        <tbody>
          <% @contest_years_history.reverse.each do |cy| %>
            <% pv = @regional_pageviews[:by_year][cy.year_id] %>
            <% next if pv.nil? %>
            <tr>
              <th><%= cy.year.year %></th>
              <td><%= fmt_int(pv[:pages_count]) %></td>
              <td><%= fmt_int(pv[:wikis_count]) %></td>
              <td><%= fmt_int(pv[:total_views]) %></td>
              <td><%= fmt_pct(pv[:top12_share]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @regional_pageviews[:top_pages].any? %>
      <h3 class="subtitle is-6 mt-4">Voci più viste</h3>
      <div class="table-container">
        <table class="table is-striped is-fullwidth is-narrow">
          <thead>
            <tr>
              <th>Voce</th>
              <th>Progetto</th>
              <th>Visite</th>
            </tr>
          </thead>
          <tbody>
            <% @regional_pageviews[:top_pages].each do |p| %>
              <tr>
                <td><%= p[:url] ? link_to(p[:page_title], p[:url], target: "_blank", rel: "noopener") : p[:page_title] %></td>
                <td><%= p[:wiki] %></td>
                <td><%= fmt_int(p[:views]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
<% end %>

<br />
<a id="show-complete" class="button is-small is-info">Mostra dati completi</a>
<div id="complete" class="is-hidden mt-3">
    <ul>
        <% @contest.as_json.each do |key, val| %>
        <li><b><%= key %>:</b> <%= val %></li>
        <% end %>
    </ul>

    <ul>
        <% @contest.contest_years.as_json.each do |key, val| %>
        <li><b><%= key %>:</b> <%= val %></li>
        <% end %>
    </ul>
</div>

<script>
    $("#show-complete").click(function() {
        $("#complete").toggleClass("is-hidden");
    });
</script>
